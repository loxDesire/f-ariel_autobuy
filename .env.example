# Скопируй в .env и заполни (или заполни через TUI: Настройки -> Сохранить).
# .env в .gitignore — секреты в git не попадают.

# Токен бота от @BotFather
TG_BOT_TOKEN=
# Куда слать: id группы (отрицательный, кнопка «Найти группу» в TUI) или личного чата
TG_CHAT_ID=
# api.telegram.org или адрес своего Cloudflare Worker (tools/tg-proxy-worker.js),
# если Telegram заблокирован
TG_API_BASE=https://api.telegram.org
