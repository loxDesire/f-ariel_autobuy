/* Ариель Бот — стили TUI */

Screen {
    background: $background;
}

/* ─── шапка ─────────────────────────────────────────────── */
#topbar {
    height: 1;
    background: $panel;
    padding: 0 1;
}
#brand { width: auto; }
#clock { width: 1fr; content-align: right middle; text-align: right; }

/* ─── боковое меню ──────────────────────────────────────── */
#body { height: 1fr; }
#sidebar {
    width: 22;
    background: $panel;
    border-right: tall $primary 40%;
}
#menu { height: auto; background: $panel; }
#menu > ListItem { padding: 1 1; }
#menu > ListItem.-highlight { background: $primary 40%; }
#content { width: 1fr; padding: 0 1; }

/* ─── общие ─────────────────────────────────────────────── */
.panel {
    border: round $primary 50%;
    padding: 0 1;
}
.panel-title { text-style: bold; color: $accent; margin-top: 1; }
.hint { color: $text-muted; padding: 0 1; }
.inline-label { padding: 1 1 0 1; width: auto; }
.field-label { color: $text-muted; margin-top: 1; }
.button-row { height: auto; margin: 1 0; }
.button-row Button { margin-right: 1; }
DataTable { height: 1fr; border: round $primary 50%; }

/* ─── запуск ────────────────────────────────────────────── */
#run-top { height: 10; }
#run-controls { width: 40; }
#run-buttons { height: auto; }
#run-buttons Button { min-width: 10; margin-right: 1; }
#mode { width: 100%; }
#run-timer { width: 1fr; align: center middle; }
#run-timer .panel-title { width: 100%; text-align: center; }
#timer { width: 100%; text-align: center; color: $accent; }
#run-status { width: 34; }
#run-logs { height: 1fr; }
#log-all { width: 2fr; border: round $primary 50%; }
#log-ok { width: 1fr; border: round $success; }

/* ─── настройки ─────────────────────────────────────────── */
SettingsPane Input { width: 70; }
.input-row Input { width: 52; }
.time-row { height: auto; }
.time-row Input { width: 8; }
.switch-row { height: auto; }
#s-mode { width: 40; }

/* ─── история ───────────────────────────────────────────── */
#history-table { height: 2fr; }
#history-detail { height: 1fr; }

/* ─── о программе ───────────────────────────────────────── */
#about-banner { margin: 1 2 0 2; }
#about-credits { margin: 0 2; color: $text-muted; }
#about-text { margin: 1 2; }

/* ─── диалоги ───────────────────────────────────────────── */
ModalScreen { align: center middle; }
.dialog {
    width: 70;
    height: auto;
    max-height: 90%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}
.dialog.wide { width: 100; }
.dialog-title { text-style: bold; color: $accent; margin-bottom: 1; }
.dialog-text { margin-bottom: 1; }
.dialog-buttons { height: auto; margin-top: 1; }
.dialog-buttons Button { margin-right: 1; }
.dialog RadioSet { width: 100%; }
#rc-recipients, #rc-delivery { height: auto; }

.input-row { height: auto; }
.input-row Button { margin-left: 1; }
